# Copy to .env.local and adjust. Never commit real secrets.

# Brand name shown site-wide. NEEDS CLIENT DECISION:
# the current site says "Forward Movement Enterprises"; the redesign brief says "Forward Movement Entertainment".
NEXT_PUBLIC_BRAND_NAME="Forward Movement Enterprises"

# Canonical site URL (used for metadata, sitemap and structured data).
NEXT_PUBLIC_SITE_URL="https://www.forwardmovementent.com"

# Review mode shows approval flags, placeholders and the /review checklist.
# Set to "false" for production: only content marked "approved" in src/content renders.
NEXT_PUBLIC_REVIEW_MODE="true"

# Allow search engines to index this deployment. Keep "false" for previews.
ALLOW_INDEXING="false"

# Contact form destination (server-side only; never exposed to the browser).
# Leave empty until the client approves a destination — the form will say it is not connected.
# The endpoint receives a JSON POST: { name, email, organization, need, phone, source, submittedAt }.
CONTACT_FORM_ENDPOINT=""
# Optional bearer token sent as "Authorization: Bearer <token>".
CONTACT_FORM_TOKEN=""
